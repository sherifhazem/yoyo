# الإعدادات دي كلها بتاعة السيرفر (Vercel) — مش بتتحط في .env المحلي
# ولا بيوصل أي منها للمتصفح أبداً.
#
# لو مش عايز تشغّل باك إند خالص، سيبها فاضية — اللعبة تفضل شغّالة
# 100% محلياً بالـ localStorage والحوار الثابت، بالظبط زي ما هي دلوقتي.

# مفتاح DeepSeek (اختياري) — بيتحط في Vercel Project Settings > Environment Variables.
# لو موجود، كابتن شريف هيرد بردود ذكية عبر /api/captain-reply بدل الحوار الثابت.
DEEPSEEK_API_KEY=

# سر توقيع جلسة الدخول (JWT) — لازم لو عايز تسجيل الدخول (اسم + PIN) يشتغل.
# أي نص عشوائي طويل يكفي، مثلاً: openssl rand -hex 32
SESSION_SECRET=

# رابط قاعدة بيانات Postgres — بيتحط تلقائياً لو ربطت المشروع بتكامل
# Vercel Postgres / Neon من لوحة تحكم Vercel، مش لازم تحطه يدوي.
# DATABASE_URL=
